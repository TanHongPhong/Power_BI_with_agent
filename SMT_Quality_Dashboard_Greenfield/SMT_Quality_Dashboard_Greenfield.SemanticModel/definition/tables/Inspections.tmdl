table Inspections
	lineageTag: fdc99cb2-2eea-42d7-81cb-79aaad6b46ca

	measure 'Total Boards' = COUNTROWS(Inspections)
		formatString: #,##0
		lineageTag: 8d18c308-9c71-4b8c-9760-e966da0a8fe0

	measure 'Pass Boards' = CALCULATE([Total Boards], Inspections[disposition] = "PASS")
		formatString: #,##0
		lineageTag: 7e5b64ed-1d77-44ec-9415-a05699a8b4d1

	measure 'Failed Boards' = CALCULATE([Total Boards], Inspections[disposition] = "FAIL")
		formatString: #,##0
		lineageTag: 2729337c-d330-45fe-b888-3857bed0bb74

	measure 'Yield %' = DIVIDE([Pass Boards], [Total Boards])
		formatString: 0.0%
		lineageTag: fa331aeb-dca9-48f1-94e5-82e64a59a510

	measure 'Defective Rate %' = DIVIDE([Failed Boards], [Total Boards])
		formatString: 0.0%
		lineageTag: f6962ac1-5e4c-4c45-ac65-1d2365d35cc2

	measure 'Total Opportunities' = SUM(Inspections[opportunities])
		formatString: #,##0
		lineageTag: 6d533994-82a6-4d7a-b2c0-262be2371fb6

	/// Yield fixed to baseline weeks 1-4; ignores conformed Phase, Week, and Shift slicers.
	measure 'Baseline Yield %' = CALCULATE ( [Yield %], REMOVEFILTERS ( 'Week' ), REMOVEFILTERS ( 'Phase' ), REMOVEFILTERS ( 'Shift' ), Inspections[week] >= 1, Inspections[week] <= 4 )
		formatString: 0.0%
		lineageTag: 8f6a7e89-b704-42c7-afdb-5331aa6c0c69

	/// Yield fixed to improved weeks 5-8; ignores conformed Phase, Week, and Shift slicers.
	measure 'Improved Yield %' = CALCULATE ( [Yield %], REMOVEFILTERS ( 'Week' ), REMOVEFILTERS ( 'Phase' ), REMOVEFILTERS ( 'Shift' ), Inspections[week] >= 5, Inspections[week] <= 8 )
		formatString: 0.0%
		lineageTag: 20347d4e-f7db-4ad3-9cf7-8d81dca7ee0e

	measure 'Yield Improvement (pp)' = [Improved Yield %]-[Baseline Yield %]
		formatString: 0.0%
		lineageTag: 60c8d280-1bc8-48a6-9fb2-07c55efc48ef

	/// Defective rate fixed to baseline weeks 1-4; ignores conformed Phase, Week, and Shift slicers.
	measure 'Baseline Defective Rate %' = CALCULATE ( [Defective Rate %], REMOVEFILTERS ( 'Week' ), REMOVEFILTERS ( 'Phase' ), REMOVEFILTERS ( 'Shift' ), Inspections[week] >= 1, Inspections[week] <= 4 )
		formatString: 0.0%
		lineageTag: daab2668-c996-4284-958b-8ca9ad498e04

	/// Defective rate fixed to improved weeks 5-8; ignores conformed Phase, Week, and Shift slicers.
	measure 'Improved Defective Rate %' = CALCULATE ( [Defective Rate %], REMOVEFILTERS ( 'Week' ), REMOVEFILTERS ( 'Phase' ), REMOVEFILTERS ( 'Shift' ), Inspections[week] >= 5, Inspections[week] <= 8 )
		formatString: 0.0%
		lineageTag: 1f359a10-5f38-4459-a6d6-3172a5812ba6


		source = let Source = Csv.Document(File.Contents("D:\\A UEH_UNIVERSITY\\MONEY\\Portfilio\\marnufacturing_digitalization\\Lean-Sigma-Learners-Portfolio\\data\\inspections.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]), Typed = Table.TransformColumnTypes(Promoted, {{"board_id", Int64.Type},{"timestamp", type datetime},{"week", Int64.Type},{"phase", type text},{"shift", type text},{"operator", type text},{"opportunities", Int64.Type},{"defect_count", Int64.Type},{"disposition", type text}}) in Typed


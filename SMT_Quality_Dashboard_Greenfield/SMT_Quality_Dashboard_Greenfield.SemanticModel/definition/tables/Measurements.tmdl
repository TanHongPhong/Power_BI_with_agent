table Measurements
	lineageTag: 83751f77-97e4-44b2-93f6-4d92910e5272

	measure 'Mean Paste Height' = AVERAGE(Measurements[paste_height_um])
		formatString: 0.00
		lineageTag: aa017db1-182f-4628-ac5a-b38131dbf0ef

	measure 'Overall Std' = STDEV.S(Measurements[paste_height_um])
		formatString: 0.00
		lineageTag: 62689ba9-9211-44d4-9613-70022bfbe3f8

	measure 'Total Measurements' = COUNTROWS(Measurements)
		formatString: #,##0
		lineageTag: e954d3b8-7a14-4c49-b862-160c50b01b7e

	measure Pp = DIVIDE(Specifications[USL Target]-Specifications[LSL Target], 6*[Overall Std])
		formatString: 0.00
		lineageTag: 2d885376-7760-43e7-8db1-c06a77959560

	measure Ppk = MIN(DIVIDE(Specifications[USL Target]-[Mean Paste Height],3*[Overall Std]),DIVIDE([Mean Paste Height]-Specifications[LSL Target],3*[Overall Std]))
		formatString: 0.00
		lineageTag: 7d23b85d-c1d1-4178-aedc-dc3e13109cf1

	measure 'Within Std' = DIVIDE(AVERAGE('SPC XbarR'[Range]), 2.326)
		formatString: 0.00
		lineageTag: df825e33-ce45-4141-b42e-3b2bf6a4ccd8

	measure Cp = DIVIDE(Specifications[USL Target]-Specifications[LSL Target], 6*[Within Std])
		formatString: 0.00
		lineageTag: 75002aaa-19ed-4bf7-aecd-445b2cdc2038

	measure Cpk = MIN(DIVIDE(Specifications[USL Target]-[Mean Paste Height],3*[Within Std]),DIVIDE([Mean Paste Height]-Specifications[LSL Target],3*[Within Std]))
		formatString: 0.00
		lineageTag: 98f06b8f-e13e-4805-ab00-ab9f978318ac


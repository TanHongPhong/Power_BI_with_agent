table defects
	lineageTag: 39d766f2-1de2-45ae-93b0-e20e5ccf380a

	measure 'Total Defects' = COUNTROWS(defects)
		formatString: #,##0
		lineageTag: ed9df01a-7f33-47e1-819d-8b0ec9764bdd

	measure DPMO = DIVIDE([Total Defects], [Total Opportunities]) * 1000000
		formatString: #,##0
		lineageTag: 787bb773-2418-4ae6-92c1-f13e21560af6

	measure 'Defect Contribution %' = DIVIDE([Total Defects], CALCULATE([Total Defects], ALLSELECTED(defects[defect_type])))
		formatString: 0.0%
		lineageTag: 2a58575c-0602-4223-b75a-ff0529d1dab5

	measure 'Pareto Cumulative %' =
			VAR CurrentCount = [Total Defects]
			RETURN IF(NOT HASONEVALUE(defects[defect_type]), BLANK(),
			    DIVIDE(SUMX(FILTER(ALLSELECTED(defects[defect_type]), CALCULATE([Total Defects]) >= CurrentCount), CALCULATE([Total Defects])),
			           CALCULATE([Total Defects], ALLSELECTED(defects[defect_type]))))
			formatString: 0.0%
		lineageTag: dada42b7-cbf5-4147-96ee-4e298ed652c4

	measure 'Boards with Selected Defect' = DISTINCTCOUNT(defects[board_id])
		formatString: #,##0
		lineageTag: 64886d65-4aa9-4c0e-9659-f97db30a0d22

	measure 'Affected Boards %' = DIVIDE([Boards with Selected Defect], [Total Boards])
		formatString: 0.0%
		lineageTag: 646226ee-fcd7-44e6-8c60-99cf0282c167

	column defect_id
		dataType: int64
		lineageTag: 81bfed81-52d3-4c9f-af11-24cf1fd327fd
		summarizeBy: sum
		sourceColumn: defect_id

		annotation SummarizationSetBy = Automatic

	column board_id
		dataType: int64
		lineageTag: 63923964-f5e4-4f0f-87a0-35b5a24aef20
		summarizeBy: none
		sourceColumn: board_id

	column timestamp
		dataType: dateTime
		lineageTag: 51cc278c-16fb-468b-9623-ad68b241fe31
		summarizeBy: none
		sourceColumn: timestamp

		variation Variation
			isDefault
			relationship: 50161d99-066b-4c43-993a-f23d6ad5d553
			defaultHierarchy: LocalDateTable_af903dcc-c9d6-40f2-9fb6-3fec8a6451d8.'Date Hierarchy'

	column week
		dataType: int64
		lineageTag: 8595bd64-195a-476a-b4f6-28202fae206c
		summarizeBy: sum
		sourceColumn: week

		annotation SummarizationSetBy = Automatic

	column phase
		dataType: string
		lineageTag: b41e50aa-66f5-4905-8087-f7546731c512
		summarizeBy: none
		sourceColumn: phase

	column defect_type
		dataType: string
		lineageTag: c6eaadee-e42e-4bc1-92c6-c6f98f337c77
		summarizeBy: none
		sourceColumn: defect_type


table inspections
	lineageTag: 5fea9608-2ed0-434f-a73b-f8a7fc4e08f9

	measure 'Total Boards' = COUNTROWS(inspections)
		formatString: #,##0
		lineageTag: 5f38e699-5dc7-4623-8575-358cc4732816

	measure 'PASS Boards' = CALCULATE([Total Boards], inspections[disposition] = "PASS")
		formatString: #,##0
		lineageTag: b6d31cad-111b-405f-a7e1-d97920656452

	measure 'FAIL Boards' = CALCULATE([Total Boards], inspections[disposition] = "FAIL")
		formatString: #,##0
		lineageTag: b28f5666-15e1-4cc9-96db-fe8a9fb4d1aa

	measure 'Yield %' = DIVIDE([PASS Boards], [Total Boards])
		formatString: 0.00%
		lineageTag: 2c810591-8e79-4606-ac8b-fdb912b02b7c

	measure 'Defective Rate %' = DIVIDE([FAIL Boards], [Total Boards])
		formatString: 0.00%
		lineageTag: ec1a9a49-ebd9-4b78-8697-08c2c58ad6f8

	measure 'Total Opportunities' = SUM(inspections[opportunities])
		formatString: #,##0
		lineageTag: 8986c37c-4e93-4530-ad6a-c2b12b7eec09

	measure 'Baseline Yield' = CALCULATE([Yield %], REMOVEFILTERS(DimWeek), REMOVEFILTERS(DimDate), DimWeek[phase]="baseline")
		formatString: 0.00%
		lineageTag: bf7d51a3-7fce-49f7-8177-f2c942b968a7

	measure 'Improved Yield' = CALCULATE([Yield %], REMOVEFILTERS(DimWeek), REMOVEFILTERS(DimDate), DimWeek[phase]="improved")
		formatString: 0.00%
		lineageTag: 35c213ad-85b5-400c-837a-ff89cdb25332

	measure 'Baseline Defective Rate' = CALCULATE([Defective Rate %], REMOVEFILTERS(DimWeek), REMOVEFILTERS(DimDate), DimWeek[phase]="baseline")
		formatString: 0.00%
		lineageTag: b85d8e72-32e9-4a6c-a32d-e9e3f8283873

	measure 'Improved Defective Rate' = CALCULATE([Defective Rate %], REMOVEFILTERS(DimWeek), REMOVEFILTERS(DimDate), DimWeek[phase]="improved")
		formatString: 0.00%
		lineageTag: a34eb4ab-e07e-4ac4-8898-2ab6feb272f7

	measure 'Baseline DPMO' = CALCULATE([DPMO], REMOVEFILTERS(DimWeek), REMOVEFILTERS(DimDate), DimWeek[phase]="baseline")
		formatString: #,##0
		lineageTag: 5b39d9a5-4c68-42c6-93da-ee3f2204af17

	measure 'Improved DPMO' = CALCULATE([DPMO], REMOVEFILTERS(DimWeek), REMOVEFILTERS(DimDate), DimWeek[phase]="improved")
		formatString: #,##0
		lineageTag: b3369a4e-1afc-46b0-ab9b-01e2724c849b

	measure 'Baseline Std' = CALCULATE([Overall Std], REMOVEFILTERS(DimWeek), REMOVEFILTERS(DimDate), DimWeek[phase]="baseline")
		formatString: 0.00
		lineageTag: 917be63d-e5fa-4cad-ac83-9cb268469a84

	measure 'Improved Std' = CALCULATE([Overall Std], REMOVEFILTERS(DimWeek), REMOVEFILTERS(DimDate), DimWeek[phase]="improved")
		formatString: 0.00
		lineageTag: e1518d0e-9e20-4a32-ad19-823546636bdf

	measure 'Yield Gain (pp)' = ([Improved Yield]-[Baseline Yield])*100
		formatString: 0.00
		lineageTag: cd3725bd-620d-49c9-bfee-20e1b4aba174

	measure 'Defective Rate Reduction %' = DIVIDE([Baseline Defective Rate]-[Improved Defective Rate],[Baseline Defective Rate])
		formatString: 0.0%
		lineageTag: 91de8aff-b7ec-4fad-9bb9-608290bed4cd

	measure 'DPMO Reduction %' = DIVIDE([Baseline DPMO]-[Improved DPMO],[Baseline DPMO])
		formatString: 0.0%
		lineageTag: 285f21f3-8f84-481a-ab61-c1a6091de760

	measure 'Variation Reduction %' = DIVIDE([Baseline Std]-[Improved Std],[Baseline Std])
		formatString: 0.0%
		lineageTag: 976a11ab-8227-452d-a91f-26e96f1cc163

	column board_id
		dataType: int64
		lineageTag: f4810144-e342-4fb7-a05e-36f4d17f59cd
		summarizeBy: none
		sourceColumn: board_id

	column timestamp
		dataType: dateTime
		lineageTag: bff40533-f435-4a72-9a41-4cb2a1695749
		summarizeBy: none
		sourceColumn: timestamp

		variation Variation
			isDefault
			relationship: 5b0861f9-add4-4177-afb6-208eff8010fd
			defaultHierarchy: LocalDateTable_40baefd9-2812-48f5-8374-d4e287e2f54e.'Date Hierarchy'

	column week
		dataType: int64
		lineageTag: 010230bc-df03-4056-aa25-cbd719115404
		summarizeBy: none
		sourceColumn: week

	column phase
		dataType: string
		lineageTag: 06369251-64b1-4c65-9bf3-42ecbac91f7b
		summarizeBy: none
		sourceColumn: phase

	column shift
		dataType: string
		lineageTag: 66abfb73-dd1b-442f-98b8-f2de969faa30
		summarizeBy: none
		sourceColumn: shift

	column operator
		dataType: string
		lineageTag: f51ef08c-f45f-4b38-bd96-0cdd8f0801fc
		summarizeBy: none
		sourceColumn: operator

	column opportunities
		dataType: int64
		lineageTag: 9fa08e9c-1bf8-4a41-a1b8-9265e4e1d7ea
		summarizeBy: sum
		sourceColumn: opportunities

		annotation SummarizationSetBy = Automatic

	column defect_count
		dataType: int64
		lineageTag: c2648ea5-bfcb-42a5-8861-93e41b38be3a
		summarizeBy: sum
		sourceColumn: defect_count

		annotation SummarizationSetBy = Automatic

	column disposition
		dataType: string
		lineageTag: 0f121f8d-5632-498f-872c-90bde9a196a7
		summarizeBy: none
		sourceColumn: disposition

	column production_date
		dataType: dateTime
		formatString: Long Date
		lineageTag: 8e5c8584-f190-4164-b9e9-fabd37f60cfd
		summarizeBy: none
		sourceColumn: production_date

		annotation UnderlyingDateTimeDataType = Date


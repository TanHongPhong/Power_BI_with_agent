                  "Value": "'import pandas as pd\nimport matplotlib.pyplot as plt\n\ndf = dataset[\n    [\"measurement_id\", \"phase\", \"paste_height_um\"]\n].dropna()\n\nphases = sorted(df[\"phase\"].unique())\n\nvalues = [\n    df.loc[\n        df[\"phase\"] == phase,\n        \"paste_height_um\"\n    ].to_numpy()\n    for phase in phases\n]\n\nfig, ax = plt.subplots(figsize=(8, 4))\n\nax.boxplot(\n    values,\n    showmeans=True,\n    showfliers=True\n)\n\nax.set_xticks(range(1, len(phases) + 1))\nax.set_xticklabels(phases)\n\nax.set_ylabel(\"Paste Height (µm)\")\nax.set_title(\"Paste Height Distribution by Phase\")\nax.grid(axis=\"y\", alpha=0.2)\n\nplt.tight_layout()\nplt.show()'"

table SPC_XbarR
	lineageTag: acb243a1-8607-45f7-86a3-f263de9f0686

	measure 'Xbar Point' =
			
			SELECTEDVALUE(SPC_XbarR[Xbar])
		lineageTag: ecb332ee-10c7-41b0-b842-19fc79b1ccba

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'R Point' =
			
			AVERAGE(SPC_XbarR[range])
		lineageTag: 0585fcdc-17e7-4c6d-b9dc-a03d6516b2c9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Xbar CL' =
			
			VAR CurrentPhase =
			    SELECTEDVALUE(SPC_XbarR[phase])
			RETURN
			IF(
			    ISBLANK(CurrentPhase),
			    BLANK(),
			    CALCULATE(
			        AVERAGE(SPC_XbarR[Xbar]),
			        REMOVEFILTERS(SPC_XbarR),
			        REMOVEFILTERS(DimWeek),
			        REMOVEFILTERS(DimDate),
			        SPC_XbarR[phase] = CurrentPhase
			    )
			)
		formatString: 0.00
		lineageTag: 27606f3d-425c-4cfb-a7bc-9b8fa91fffa3

	measure 'R CL' =
			
			VAR CurrentPhase =
			    SELECTEDVALUE(SPC_XbarR[phase])
			RETURN
			IF(
			    ISBLANK(CurrentPhase),
			    BLANK(),
			    CALCULATE(
			        AVERAGE(SPC_XbarR[range]),
			        REMOVEFILTERS(SPC_XbarR),
			        REMOVEFILTERS(DimWeek),
			        REMOVEFILTERS(DimDate),
			        SPC_XbarR[phase] = CurrentPhase
			    )
			)
		formatString: 0
		lineageTag: cda0f12b-2e69-4b54-b428-27ac44b83f72

	measure 'Xbar UCL' =
			
			[Xbar CL] + 0.577 * [R CL]
		formatString: 0.00
		lineageTag: 22e6e6b8-befa-4e5c-8784-905d2dab23b8

	measure 'Xbar LCL' =
			
			[Xbar CL] - 0.577 * [R CL]
		formatString: 0.00
		lineageTag: 87cc8090-98b1-4382-a275-9d97fae3e832

	measure 'R UCL' =
			
			2.114 * [R CL]
		lineageTag: f26ef422-b660-4045-8a57-7954da415237

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'R LCL' =
			
			IF(
			    ISBLANK([R CL]),
			    BLANK(),
			    0
			)
		formatString: 0
		lineageTag: 93a0e858-2a42-422e-9363-39b26c06d728


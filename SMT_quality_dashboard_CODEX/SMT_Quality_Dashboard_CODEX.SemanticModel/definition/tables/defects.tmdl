		formatString: General Date
		lineageTag: fffe9a79-242f-4a4c-a2c4-025848b7ade6
		summarizeBy: none
		sourceColumn: timestamp

		variation Variation
			isDefault
			relationship: df77aea5-f9e8-4636-9902-d9df99f63b93
			defaultHierarchy: LocalDateTable_b39a42fc-006f-495d-8c67-86fb24ada160.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column week
		dataType: int64
		formatString: 0
		lineageTag: fa7f7f9c-3567-4ca5-a309-945d3803d0c6
		summarizeBy: sum
		sourceColumn: week

		annotation SummarizationSetBy = Automatic

	column phase
		dataType: string
		lineageTag: 892a750c-ee43-45bf-8ad4-b461f5c28c1d
		summarizeBy: none
		sourceColumn: phase

		annotation SummarizationSetBy = Automatic

	column defect_type
		dataType: string
		lineageTag: f504d49f-263a-4b71-9528-7acfcf234e27
		summarizeBy: none
		sourceColumn: defect_type

		annotation SummarizationSetBy = Automatic


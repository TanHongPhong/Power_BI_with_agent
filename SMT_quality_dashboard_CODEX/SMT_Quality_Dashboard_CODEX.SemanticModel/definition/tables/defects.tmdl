table defects
	lineageTag: 2744533f-1d29-4e69-9c75-92f519ca4be2

	measure 'Total defects' = COUNTROWS(defects)
		formatString: 0
		lineageTag: 9b203bc9-a09a-4ca0-8df0-d83ea794f32c

	measure 'Total Opportunities' = SUM(inspections[opportunities])
		formatString: 0
		lineageTag: 6ba382bb-99f1-4cbc-b122-1efa7f999197

	measure DPMO = [Total defects]/[Total Opportunities]*10^6
		lineageTag: 1b5126e9-b3fe-45ba-b981-92e846786582

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column defect_id
		dataType: int64
		formatString: 0
		lineageTag: 75a6659b-f0c8-4ff4-bbf1-84c2fcb4a4b1
		summarizeBy: sum
		sourceColumn: defect_id

		annotation SummarizationSetBy = Automatic

	column board_id
		dataType: int64
		formatString: 0
		lineageTag: cf9e71c1-9631-4a69-a855-c3161fb15315
		summarizeBy: none
		sourceColumn: board_id

		annotation SummarizationSetBy = Automatic

	column timestamp

	column 'paste_height_um (bins)' =
			IF(
				ISBLANK('measurements'[paste_height_um]),
				BLANK(),
				IF(
					'measurements'[paste_height_um] >= 0,
					ROUNDDOWN('measurements'[paste_height_um] / 2, 0) * 2,
					ROUNDUP('measurements'[paste_height_um] / 2, 0) * 2

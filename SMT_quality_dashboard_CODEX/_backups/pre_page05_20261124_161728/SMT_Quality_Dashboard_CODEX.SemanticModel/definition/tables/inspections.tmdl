table inspections
	lineageTag: d3bea2ee-f31f-424b-b5ad-53cc25fb465b

	measure Total_board = COUNTROWS(inspections)
		formatString: 0
		lineageTag: 56e08d68-0766-48ea-9e5c-afc0d5dd2376

	measure Pass_board = CALCULATE([Total_board],inspections[disposition]="PASS")
		formatString: 0
		lineageTag: c7762961-be79-470c-beb7-166ffb519c8b

	measure 'Fail board' = CALCULATE([Total_board],inspections[disposition]="FAIL")
		formatString: 0
		lineageTag: c9f9edff-b1f5-431a-9ab7-75fc463fe36c

	measure 'Yield %' = [Pass_board]/[Total_board]
		lineageTag: 334ef70d-fa03-496e-99de-8ce5f1e80418

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Defective Rate %' = [Fail board]/[Total_board]
		lineageTag: 6f190718-8ea3-486e-af60-6053ba7dba90

		annotation PBI_FormatHint = {"isGeneralNumber":true}


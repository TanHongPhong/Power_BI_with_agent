table measurements
	lineageTag: c3801955-cfd3-4b37-9f6e-49b5f9c9b399

	measure 'Total Measurements' = COUNTROWS(measurements)
		formatString: #,##0
		lineageTag: 3424be87-2b8f-4678-9ad5-5848e823268a

	measure 'Mean Height' = AVERAGE(measurements[paste_height_um])
		formatString: 0.00
		lineageTag: 0a0f2998-19bd-48fc-adc0-57d9156a1287

	measure 'Overall Std' = STDEV.S(measurements[paste_height_um])
		formatString: 0.00
		lineageTag: e9fea292-3854-471b-a09e-8736bcb1e7f7

	measure 'Within Std' = DIVIDE(AVERAGE(SPC_XbarR[R]), 2.326)
		formatString: 0.00
		lineageTag: d3705b21-81ad-48d6-998c-3f5be40f918b

	measure 'Min Height' = MIN(measurements[paste_height_um])
		formatString: 0.00
		lineageTag: 2ffddc9b-6d5f-40ab-a778-0ad639100332

	measure 'Max Height' = MAX(measurements[paste_height_um])
		formatString: 0.00
		lineageTag: 47596376-fee8-48fa-9422-2c488f073c8a

	measure LSL = SELECTEDVALUE(specs[lsl])
		formatString: 0.0
		lineageTag: 4d8e5cf7-2bcf-48c1-8c58-1cb8f6724dce

	measure USL = SELECTEDVALUE(specs[usl])
		formatString: 0.0
		lineageTag: c722e28b-94c1-4d0b-85ee-c4f0024f68da

	measure Target = SELECTEDVALUE(specs[target])
		formatString: 0.0
		lineageTag: 5435507a-7ae4-45ae-9149-2f83c70b0754

	measure Cp = DIVIDE([USL]-[LSL], 6*[Within Std])
		formatString: 0.00
		lineageTag: c29c7844-b395-4775-9514-e76a785965ef

	measure Cpk = MIN(DIVIDE([USL]-[Mean Height],3*[Within Std]),DIVIDE([Mean Height]-[LSL],3*[Within Std]))
		formatString: 0.00
		lineageTag: c70f11d7-af70-4288-b4be-4be4b1bc69b3

	measure Pp = DIVIDE([USL]-[LSL],6*[Overall Std])
		formatString: 0.00
		lineageTag: 02416bdd-2e83-4b38-af1d-ff65559e674a

	measure Ppk = MIN(DIVIDE([USL]-[Mean Height],3*[Overall Std]),DIVIDE([Mean Height]-[LSL],3*[Overall Std]))
		formatString: 0.00
		lineageTag: 675c4721-5c76-46f7-8a5d-aa7785a525dc

	measure 'Out of Spec Count' = VAR Lo=[LSL] VAR Hi=[USL] RETURN COUNTROWS(FILTER(measurements, measurements[paste_height_um]<Lo || measurements[paste_height_um]>Hi))
		formatString: #,##0
		lineageTag: fdf1799c-4ff2-48b7-9eaf-2944a7352ed0

	measure 'Out of Spec %' = DIVIDE([Out of Spec Count],[Total Measurements])
		formatString: 0.00%
		lineageTag: 71f801ae-dc12-4d24-8b8c-69202658a724

	measure 'Q1 Height' = PERCENTILEX.INC(measurements,measurements[paste_height_um],0.25)
		formatString: 0.00
		lineageTag: cea8fea6-d020-4b54-9bfb-e69845b584f5

	measure 'Median Height' = MEDIAN(measurements[paste_height_um])
		formatString: 0.00
		lineageTag: b9aa1b7b-34ad-435c-a6f0-478d526f5855

	measure 'Q3 Height' = PERCENTILEX.INC(measurements,measurements[paste_height_um],0.75)
		formatString: 0.00
		lineageTag: 72783f1c-4d84-4077-b6a8-cd9c875c9453

	measure 'IQR Height' = [Q3 Height]-[Q1 Height]
		formatString: 0.00
		lineageTag: 34f57f08-ffb1-4318-b65b-f9cac569719a

	measure 'Box Outliers' = VAR Low=[Q1 Height]-1.5*[IQR Height] VAR High=[Q3 Height]+1.5*[IQR Height] RETURN COUNTROWS(FILTER(measurements,measurements[paste_height_um]<Low || measurements[paste_height_um]>High))
		formatString: #,##0
		lineageTag: b0e11ca0-c1a4-4981-ae4a-427c23c3f7fb

	column measurement_id
		dataType: int64
		lineageTag: 561342de-039d-453e-a513-774c66f6d751
